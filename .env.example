# Travelpayouts Data API
# Sign up for a token at https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=your_token_here

# Optional. Restricts results to a specific market (e.g. "us", "in", "ru").
# Default for this project is `in` (see config/fetch.json) because the
# configured routes are India-origin. Override here if you need another cache.
TRAVELPAYOUTS_MARKET=in
